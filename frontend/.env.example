# ===============================================
# Frontend Environment Configuration (Template)
# ===============================================

# Express Backend API URL (must include /api prefix)
# Development (Local Express server):
VITE_API_URL=http://localhost:5000/api

# Production (Deployed Render Web Service):
# Example: https://student-records-backend.onrender.com/api
# IMPORTANT: In Vercel Project Settings -> Environment Variables,
# set VITE_API_URL to your deployed Render URL without a trailing slash.
# VITE_API_URL=https://student-records-backend.onrender.com/api
