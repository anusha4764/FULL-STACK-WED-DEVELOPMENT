# ===============================================
# Backend Environment Configuration (Template)
# Copy this file to .env and configure your values
# ===============================================

# Port number for Express server (Render automatically injects PORT in production)
PORT=5000

# Node Environment: 'development' or 'production'
NODE_ENV=development

# MongoDB Atlas Connection URI
# Replace <username>, <password>, and <cluster-url> with your MongoDB Atlas details
# Example: mongodb+srv://admin_user:YourSecretPass123@cluster0.abcde.mongodb.net/student_records?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@cluster0.xxxxx.mongodb.net/student_db?retryWrites=true&w=majority

# Frontend Origin Whitelist for CORS
# In development: http://localhost:5173 (Vite default)
# In production: Your deployed Vercel domain (e.g., https://your-project.vercel.app)
# You can provide multiple comma-separated domains
FRONTEND_URL=http://localhost:5173,http://localhost:3000,https://your-app.vercel.app
